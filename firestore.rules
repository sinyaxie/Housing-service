rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Admin anawekwa kwa mkono kwenye Firebase Console (SETUP.md hatua ya 6).
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Wasifu wa dalali: jina na simu.
    match /brokers/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update: if signedIn() && request.auth.uid == uid;
    }

    // Vyumba: kila mtu anaona vilivyokubaliwa. Dalali anaona vyake. Admin anaona vyote.
    match /rooms/{id} {
      allow read: if resource.data.status == 'approved'
                  || (signedIn() && resource.data.ownerId == request.auth.uid)
                  || isAdmin();
      allow create: if signedIn()
                    && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.taken == false
                    && request.resource.data.price is number
                    && request.resource.data.chuo is string
                    && request.resource.data.title is string
                    && request.resource.data.title.size() <= 100;
      // Dalali anaweza kubadilisha "taken" tu. Admin anaweza kila kitu.
      allow update: if isAdmin()
                    || (signedIn() && resource.data.ownerId == request.auth.uid
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['taken']));
      allow delete: if isAdmin() || (signedIn() && resource.data.ownerId == request.auth.uid);
    }

    // Picha kubwa za chumba (zinapakiwa mtu akifungua chumba).
    match /roomPhotos/{id} {
      function room() { return get(/databases/$(database)/documents/rooms/$(id)).data; }
      allow read: if room().status == 'approved'
                  || (signedIn() && room().ownerId == request.auth.uid)
                  || isAdmin();
      allow create: if signedIn() && room().ownerId == request.auth.uid;
      allow delete: if isAdmin() || (signedIn() && room().ownerId == request.auth.uid);
    }
  }
}
